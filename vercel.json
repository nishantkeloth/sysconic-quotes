{
  "version": 2,
  "builds": [
    { "src": "api/auth.py",   "use": "@vercel/python" },
    { "src": "api/quotes.py", "use": "@vercel/python" },
    { "src": "api/ai.py",     "use": "@vercel/python" },
    { "src": "api/pdf.py", "use": "@vercel/python" },
    { "src": "api/products.py", "use": "@vercel/python" },
    { "src": "api/bom.py", "use": "@vercel/python" },
    { "src": "api/customers.py", "use": "@vercel/python" },
    { "src": "api/vendors.py", "use": "@vercel/python" },
    { "src": "api/integrations.py", "use": "@vercel/python" },
    { "src": "index.html",    "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth/(.*)",   "dest": "api/auth.py" },
    { "src": "/api/quotes/(.*)", "dest": "api/quotes.py" },
    { "src": "/api/quotes",      "dest": "api/quotes.py" },
    { "src": "/api/ai/(.*)",     "dest": "api/ai.py" },
    { "src": "/api/pdf/(.*)", "dest": "api/pdf.py" },
    { "src": "/api/products/(.*)", "dest": "api/products.py" },
    { "src": "/api/products",      "dest": "api/products.py" },
    { "src": "/api/bom/(.*)", "dest": "api/bom.py" },
    { "src": "/api/customers/(.*)", "dest": "api/customers.py" },
    { "src": "/api/customers",      "dest": "api/customers.py" },
    { "src": "/api/vendors/(.*)", "dest": "api/vendors.py" },
    { "src": "/api/vendors",      "dest": "api/vendors.py" },
    { "src": "/api/integrations/(.*)", "dest": "api/integrations.py" },
    { "src": "/api/integrations",      "dest": "api/integrations.py" },
    { "src": "/(.*)",            "dest": "index.html" }
  ],
  "crons": [
    { "path": "/api/integrations/run-auto-sync", "schedule": "0 3 * * *" }
  ]
}
