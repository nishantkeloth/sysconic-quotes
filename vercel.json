{
  "version": 2,
  "builds": [
    { "src": "api/auth.py",   "use": "@vercel/python" },
    { "src": "api/quotes.py", "use": "@vercel/python", "config": { "maxDuration": 45 } },
    { "src": "api/ai.py",     "use": "@vercel/python" },
    { "src": "api/pdf.py", "use": "@vercel/python" },
    { "src": "api/products.py", "use": "@vercel/python" },
    { "src": "api/bom.py", "use": "@vercel/python" },
    { "src": "api/customers.py", "use": "@vercel/python" },
    { "src": "api/vendors.py", "use": "@vercel/python" },
    { "src": "api/integrations.py", "use": "@vercel/python" },
    { "src": "api/platform.py", "use": "@vercel/python" },
    { "src": "api/proposal.py", "use": "@vercel/python", "config": { "maxDuration": 60 } },
    { "src": "api/projects.py", "use": "@vercel/python" },
{ "src": "api/fsm_assets.py", "use": "@vercel/python" },
{ "src": "api/fsm_tickets.py", "use": "@vercel/python" },
{ "src": "api/fsm_engineers.py", "use": "@vercel/python" },
{ "src": "api/fsm_pm.py", "use": "@vercel/python" },
{ "src": "api/fsm_contracts.py", "use": "@vercel/python" },
{ "src": "api/fsm_parts.py", "use": "@vercel/python" },
{ "src": "api/fsm_notify.py", "use": "@vercel/python" },
{ "src": "api/fsm_reports.py", "use": "@vercel/python" },
{ "src": "api/fsm_kb.py", "use": "@vercel/python" },
{ "src": "api/fsm_ai.py", "use": "@vercel/python" },
{ "src": "api/fsm_portal.py", "use": "@vercel/python" },
    { "src": "api/pdf-render.js", "use": "@vercel/node", "config": { "maxLambdaSize": "250mb", "maxDuration": 30, "memory": 3009 } },
        { "src": "index.html",    "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/pdf/render2", "dest": "api/pdf-render.js" },
    { "src": "/api/auth/(.*)",   "dest": "api/auth.py" },
    { "src": "/api/quotes/(.*)", "dest": "api/quotes.py" },
    { "src": "/api/quotes",      "dest": "api/quotes.py" },
    { "src": "/api/deals/(.*)", "dest": "api/quotes.py" },
    { "src": "/api/deals",      "dest": "api/quotes.py" },
    { "src": "/api/ai/(.*)",     "dest": "api/ai.py" },
    { "src": "/api/pdf/(.*)", "dest": "api/pdf.py" },
    { "src": "/api/products/(.*)", "dest": "api/products.py" },
    { "src": "/api/products",      "dest": "api/products.py" },
    { "src": "/api/bom/(.*)", "dest": "api/bom.py" },
    { "src": "/api/diagram/(.*)", "dest": "api/ai.py" },
    { "src": "/api/customers/(.*)", "dest": "api/customers.py" },
    { "src": "/api/customers",      "dest": "api/customers.py" },
    { "src": "/api/vendors/(.*)", "dest": "api/vendors.py" },
    { "src": "/api/vendors",      "dest": "api/vendors.py" },
    { "src": "/api/integrations/(.*)", "dest": "api/integrations.py" },
    { "src": "/api/integrations",      "dest": "api/integrations.py" },
    { "src": "/api/platform/(.*)", "dest": "api/platform.py" },
    { "src": "/api/platform",      "dest": "api/platform.py" },
    { "src": "/api/proposal/(.*)", "dest": "api/proposal.py" },
    { "src": "/api/proposal",      "dest": "api/proposal.py" },
    { "src": "/api/projects/(.*)", "dest": "api/projects.py" },
    { "src": "/api/testimonials/(.*)", "dest": "api/projects.py" },
    { "src": "/api/testimonials", "dest": "api/projects.py" },
    { "src": "/api/projects",      "dest": "api/projects.py" },
    { "src": "/api/project-performance/(.*)", "dest": "api/projects.py" },
    { "src": "/api/project-performance",      "dest": "api/projects.py" },
    { "src": "/api/pp-sync/(.*)", "dest": "api/projects.py" },
    { "src": "/api/pp-sync",      "dest": "api/projects.py" },
{ "src": "/api/fsm_assets/(.*)", "dest": "api/fsm_assets.py" },
{ "src": "/api/fsm_assets",      "dest": "api/fsm_assets.py" },
{ "src": "/api/fsm_tickets/(.*)", "dest": "api/fsm_tickets.py" },
{ "src": "/api/fsm_tickets",      "dest": "api/fsm_tickets.py" },
{ "src": "/api/fsm_engineers/(.*)", "dest": "api/fsm_engineers.py" },
{ "src": "/api/fsm_engineers",      "dest": "api/fsm_engineers.py" },
{ "src": "/api/fsm_pm/(.*)", "dest": "api/fsm_pm.py" },
{ "src": "/api/fsm_pm",      "dest": "api/fsm_pm.py" },
{ "src": "/api/fsm_contracts/(.*)", "dest": "api/fsm_contracts.py" },
{ "src": "/api/fsm_contracts",      "dest": "api/fsm_contracts.py" },
{ "src": "/api/fsm_parts/(.*)", "dest": "api/fsm_parts.py" },
{ "src": "/api/fsm_parts",      "dest": "api/fsm_parts.py" },
{ "src": "/api/fsm_notify/(.*)", "dest": "api/fsm_notify.py" },
{ "src": "/api/fsm_notify",      "dest": "api/fsm_notify.py" },
{ "src": "/api/fsm_reports/(.*)", "dest": "api/fsm_reports.py" },
{ "src": "/api/fsm_reports",      "dest": "api/fsm_reports.py" },
{ "src": "/api/fsm_kb/(.*)", "dest": "api/fsm_kb.py" },
{ "src": "/api/fsm_kb",      "dest": "api/fsm_kb.py" },
{ "src": "/api/fsm_ai/(.*)", "dest": "api/fsm_ai.py" },
{ "src": "/api/fsm_ai",      "dest": "api/fsm_ai.py" },
{ "src": "/api/fsm_portal/(.*)", "dest": "api/fsm_portal.py" },
{ "src": "/api/fsm_portal",      "dest": "api/fsm_portal.py" },
{ "src": "/(.*)",            "dest": "index.html" }
  ],
  "crons": [
    { "path": "/api/integrations/run-auto-sync", "schedule": "0 3 * * *" },
    { "path": "/api/pp-sync/run-auto-sync", "schedule": "0 4 * * *" },
    { "path": "/api/fsm_pm/run-auto-generate", "schedule": "0 5 * * *" },
    { "path": "/api/fsm_notify/run-checks", "schedule": "0 6 * * *" }
  ]
}
